# SolidWorks lock/temp files (created while a part is open)
~$*.SLD*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Run outputs (generated STEP/AEDT files, state, plots) -- these are
# backed up elsewhere, not committed.
runs/

# Long sweeps: each sweep's state, results, logs and alerts stay local (see
# SWEEPS.md). The example plans are kept.
/sweeps/*
!/sweeps/examples/

# Third-party JS/WASM for the in-browser STEP viewer (three.js +
# occt-import-js, ~8 MB). Fetched once with `python -m
# microwave_package.fetch_vendor`; not committed.
microwave_package/vendor/


*.log
*.lnk

# The shared equations file's baseline record and lock (see
# design/step_generation.py): local to each checkout, never committed.
base_parts/*.txt.baseline
base_parts/*.txt.lock
